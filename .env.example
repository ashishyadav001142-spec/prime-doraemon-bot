# ====================================================================
# PRIME DORAEMON BOT - ENVIRONMENT CONFIGURATION
# ====================================================================

# 1. Telegram Bot Token obtained from @BotFather
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz1234567
BOT_TOKEN=your_telegram_bot_token_here

# 2. Supabase Project URL
# Found in Supabase Dashboard -> Project Settings -> API -> Project URL
# Example: https://xyzcompanyproject.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# 3. Supabase Secret Service Role Key (FOR BACKEND BOT USE ONLY)
# Found in Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role (secret)
# IMPORTANT: Never place this key in public GitHub repositories or the Android APK!
SUPABASE_KEY=your_supabase_service_role_key_here

# 4. Web Service Port (Render automatically sets this; default is 10000)
PORT=10000

# 5. Auto Delete Timer in Seconds (Default: 900s = 15 minutes)
AUTO_DELETE_SECONDS=900
